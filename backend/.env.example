# ECHO backend settings — local Mac setup.
# scripts/setup_mac.sh copies this to backend/.env and generates the secrets
# marked (auto). NEVER commit .env and never put these values in the iOS app.

ECHO_ENV=development

# (auto) Bearer token the iOS app sends — paste it into ECHO → Settings → AI & backend.
ECHO_API_TOKEN=

# --- Claude ------------------------------------------------------------------------
# "mock" works offline with no key; "anthropic" uses Claude (console.anthropic.com → API keys).
ECHO_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_CHAT_EFFORT=medium
ANTHROPIC_CHAT_THINKING=between_tools

# --- Local PostgreSQL (Homebrew / Postgres.app) -----------------------------------------
# (auto) postgresql://localhost:5432/echo  — add user:password@ if your server needs them.
DATABASE_URL=

# --- Scheduler ------------------------------------------------------------------------
# "mock" = deliveries recorded in the database only; "instagram" = real DMs.
ECHO_MESSAGING_PROVIDER=mock
ECHO_RUN_WORKER=true
WORKER_INTERVAL_SECONDS=5

# --- Cloudflare Tunnel — see docs/META_SETUP.md §2 -----------------------------------------
# Leave both empty to use a free *quick tunnel* (random URL that changes every start;
# scripts/start.sh hands it to the server automatically).
# For a *named tunnel* with a fixed hostname, set both:
ECHO_PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_NAME=

# --- Instagram — see docs/META_SETUP.md -----------------------------------------------------
# New Meta apps use "Instagram API with Unified Login" (the default here).
META_LOGIN_MODE=unified
# App settings → Basic → App ID and App secret (the Meta app's, not an Instagram app ID)
META_APP_ID=
META_APP_SECRET=
# Instagram → API setup with Unified login → your login configuration's ID (config_id)
META_LOGIN_CONFIG_ID=
# Optional: extra query params from the dashboard's generated login URL, e.g. display=popup
META_LOGIN_EXTRA_PARAMS=
# Legacy only (META_LOGIN_MODE=instagram, apps that still have "API setup with Instagram login"):
# the Instagram app ID; META_APP_SECRET is then the Instagram app secret.
META_INSTAGRAM_APP_ID=
# (auto) any long random string; paste the same value into the Meta webhook settings
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# (auto) encrypts Instagram tokens at rest. Keep it stable: changing it means reconnecting.
ECHO_TOKEN_ENCRYPTION_KEY=
MESSAGE_RETENTION_DAYS=30

DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# Safety net for missed webhooks: pull the 5 latest Instagram chats every N seconds (0 = off).
INSTAGRAM_POLL_SECONDS=30
