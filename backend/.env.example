# Copy to .env and fill in. NEVER commit .env and never put these in the iOS app.

ECHO_ENV=development

# Bearer token the iOS app sends (paste it into ECHO → Settings → AI & backend).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ECHO_API_TOKEN=change-me

# --- AI ------------------------------------------------------------------------
# "mock" works offline with no key; "anthropic" uses Claude.
ECHO_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_CHAT_EFFORT=medium
ANTHROPIC_CHAT_THINKING=between_tools

# --- Database ------------------------------------------------------------------
# Local:    postgresql://localhost:5432/echo
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=

# --- Scheduler -------------------------------------------------------------------
# "mock" = deliveries are recorded in the database only (until Phase 4).
ECHO_MESSAGING_PROVIDER=mock
# Run the worker inside the API process (simplest). Set false if you run
# `python -m app.worker` as a separate service.
ECHO_RUN_WORKER=true
WORKER_INTERVAL_SECONDS=5

# --- Meta (Phase 4) --------------------------------------------------------------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
